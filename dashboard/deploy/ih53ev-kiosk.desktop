[Desktop Entry]
Name=IH-53 EV Dashboard
Comment=Instrument cluster (Chromium kiosk)
Exec=chromium-browser --kiosk --noerrdialogs --disable-infobars --check-for-update-interval=31536000 --app=http://127.0.0.1:10000/
Terminal=false
Type=Application
X-GNOME-Autostart-enabled=true
# Copy to ~/.config/autostart/ or labwc/wayfire autostart on the Pi 5
# Touch Display 2. Power is Always_Hot via SW5 Instruments — see schematic/wires.md §11.
